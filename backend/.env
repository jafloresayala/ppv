# Nexar API — elige UNA de las dos opciones:
#
# Opción 1 (manual, token dura ~24h): copia el header "token" de DevTools
NEXAR_TOKEN=
#
# Opción 2 (RECOMENDADA — completamente automática, sin intervención del usuario):
#   1. Regístrate gratis en https://nexar.com/api
#   2. Crea una aplicación y copia el Client ID y Client Secret
#   3. Pégalos aquí — el sistema obtiene y renueva el token automáticamente
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=